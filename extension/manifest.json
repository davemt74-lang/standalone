{
  "manifest_version": 3,
  "name": "Annotated",
  "version": "0.14.0",
  "description": "Annotated v0.14 Chrome sidebar paired with Research Workspace Intelligence, annotation intelligence, capture, Team Chat, Agent Chat, source integrity, search, notifications, and moderation.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Annotated"
  },
  "minimum_chrome_version": "116"
}
