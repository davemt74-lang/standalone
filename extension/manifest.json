{
  "manifest_version": 3,
  "name": "Annotated",
  "version": "0.6.0",
  "description": "Annotated Chrome sidebar for capture, source-aware feeds, hardened Live rooms with Cloak Mode, public discovery, and Research.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "tabCapture"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Annotated"
  }
}
